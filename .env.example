# Copie este arquivo para .env (NUNCA versionado — já está no .gitignore) e preencha com valores reais.
# Nenhum valor real deve aparecer aqui, em commits, em logs ou na documentação pública.

# --- LinkedIn OAuth (Passo 3) ---
# Obtidos no Developer Portal, app associado a uma LinkedIn Page, produtos:
#   "Share on LinkedIn" (w_member_social) + "Sign In with LinkedIn using OpenID Connect" (openid, profile)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8080/api/v1/linkedin/oauth/callback
LINKEDIN_SCOPES=openid profile w_member_social

# --- Cifragem de tokens em repouso (Passo 6/8) ---
# Chave Base64 que decodifica para exatamente 32 bytes; usada com AES-256-GCM
# para cifrar access/refresh tokens antes de persistir no SQLite.
# Gerar com, por exemplo: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# --- Aplicação ---
APP_BASE_URL=http://localhost:8080

# --- Banco de dados ---
# Local: SQLite. Em produção, use SPRING_PROFILES_ACTIVE=prod e uma URL JDBC PostgreSQL,
# por exemplo jdbc:postgresql://db-host:5432/linkedinagent?sslmode=require.
DATABASE_URL=jdbc:sqlite:./data/linkedinagent-local.db
DATABASE_USERNAME=
DATABASE_PASSWORD=

# --- Perfil de produção ---
# SPRING_PROFILES_ACTIVE=prod
# DATABASE_URL=jdbc:postgresql://db-host:5432/linkedinagent?sslmode=require
# DATABASE_USERNAME=
# DATABASE_PASSWORD=
# CORS_ALLOWED_ORIGINS=https://seu-frontend.example

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Rate limiting em produção ---
# Redis compartilhado entre instâncias; use rediss:// quando o serviço oferecer TLS.
# RATE_LIMIT_REDIS_URL=rediss://:<senha>@redis-host:6379
# Segredo Base64 de pelo menos 32 bytes para pseudonimizar IPs, contas, sessões e state nas chaves Redis.
# Em local, pode deixar a chave de desenvolvimento abaixo; nunca a reutilize em produção.
RATE_LIMIT_HMAC_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
