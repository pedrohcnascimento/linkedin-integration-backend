# Copie este arquivo para .env (NUNCA versionado — já está no .gitignore) e preencha com valores reais.
# Nenhum valor real deve aparecer aqui, em commits, em logs ou na documentação pública.

# --- LinkedIn OAuth (Passo 3) ---
# Obtidos no Developer Portal, app associado a uma LinkedIn Page, produtos:
#   "Share on LinkedIn" (w_member_social) + "Sign In with LinkedIn using OpenID Connect" (openid, profile)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8080/api/v1/linkedin/oauth/callback
LINKEDIN_SCOPES=openid profile w_member_social

# --- Cifragem de tokens em repouso (Passo 6/8) ---
# Chave Base64 que decodifica para exatamente 32 bytes; usada com AES-256-GCM
# para cifrar access/refresh tokens antes de persistir no SQLite.
# Gerar com, por exemplo: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# --- Aplicação ---
APP_BASE_URL=http://localhost:8080

# --- Banco de dados (perfil local; perfil prod usará PostgreSQL futuramente) ---
DATABASE_URL=jdbc:sqlite:./data/linkedinagent-local.db
DATABASE_USERNAME=
DATABASE_PASSWORD=

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
