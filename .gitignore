# Exceção mínima: migrations Flyway cujo nome contém "credentials" (schema, sem segredos).
# NÃO reabilitar src/ inteiro: segredos acidentais dentro de src/ devem continuar ignorados.
!src/main/resources/db/migration/*/V*__*credentials*.sql

